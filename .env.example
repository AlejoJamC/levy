# Anthropic API Key (Required for 'anthropic' provider)
ANTHROPIC_API_KEY=sk-ant-placeholder

# Models and prices (LEV-23). Levy's code names no LLM model and no price:
# they change every few months, so they live here. The first entry of each
# list is the default.
#
# Anthropic: model:input_usd_per_mtok:output_usd_per_mtok, comma-separated.
# The model and its two prices always travel together.
# Uncomment and fill in; an entry that is not model:number:number is rejected.
# LEVY_ANTHROPIC_MODELS=<anthropic-model-id>:<input USD per MTok>:<output USD per MTok>
# Ollama models served by your local `ollama serve`, comma-separated.
# LEVY_OLLAMA_MODELS=<ollama-model>
# LEVY_OLLAMA_EMBEDDING_MODELS=<ollama-embedding-model>

# Optional configuration overrides (if supported by config loading logic in future)
# LEVY_LLM_PROVIDER=anthropic
# LEVY_EMBEDDING_PROVIDER=sentence-transformers
